# Public browser configuration (the anon key is designed to be public; RLS still applies)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server only — never prefix these with NEXT_PUBLIC_ or expose them in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REPLICATE_API_TOKEN=r8_your-token
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ID=price_your-recurring-price

APP_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
