# Public browser configuration (the anon key is designed to be public; RLS still applies)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server only — never prefix these with NEXT_PUBLIC_ or expose them in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REPLICATE_API_TOKEN=r8_your-token
REPLICATE_WEBHOOK_SECRET=use-another-long-random-value
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PRICE_ID=price_your-recurring-price
# For PayPal, switch provider to paypal and set these six server-only variables.
BILLING_PROVIDER=paypal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_PLAN_ID=P-your-active-monthly-plan
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_MONTHLY_PRICE=14.99
CRON_SECRET=use-a-long-random-value

APP_URL=http://localhost:3000
OWNER_EMAIL=owner@example.com
